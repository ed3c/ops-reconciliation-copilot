# Export these in your shell; .env is not automatically loaded.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Hosted Vercel only: provision PostgreSQL and initialize schema first.
# DATABASE_URL=postgresql://...

# Required on Vercel or whenever an OpenRouter key is configured.
# Generate a unique random password (32+ characters). Never reuse an API key.
RECON_OWNER_PASSWORD=
