# Export these in your shell; .env is not automatically loaded.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Hosted database, initialized before serving requests.
# DATABASE_URL=postgresql://...

# Google Identity Services Web client ID; not a secret.
GOOGLE_CLIENT_ID=
# One exact Gmail account; only server-side checks grant access.
OWNER_GOOGLE_EMAIL=
# Optional stable Google account ID; obtain after owner login at /auth/me.
OWNER_GOOGLE_SUB=
# Unique random server secret, at least 32 characters. Never publish.
AUTH_SESSION_SECRET=

# Optional isolated research only; NOT used by the production application.
# python scripts/research.py is offline even when these are populated.
# python scripts/research.py live makes at most four paid synthetic-header calls.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
